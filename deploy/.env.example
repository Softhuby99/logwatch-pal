# --- Server users ---
# Existing system user that owns ./logs and runs the logsrv container.
# Defaults match a freshly created `logcollector` user (uid/gid 1001).
LOG_SRV_USER=logcollector
LOG_SRV_UID=1001
LOG_SRV_GID=1001
DB_USER=dashboard
DB_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com

# --- Backup ---
BACKUP_PATH=./backups
BACKUP_CRON=0 3 * * *

# --- Web ---
# SERVER_IP: which host IP the bundled proxy binds to. 0.0.0.0 = all interfaces.
# install.sh will detect the host IPs and let you choose interactively.
SERVER_IP=0.0.0.0
HOSTNAME=dashboard.local
ENABLE_HTTPS=true

# --- Reverse proxy mode ---
# INSTALL_PROXY=true  -> bundled nginx proxy on :80/:443 (default, all-in-one).
# INSTALL_PROXY=false -> no bundled proxy; dashboard + authentik publish their
#   own ports so an EXTERNAL reverse proxy (e.g. OPNsense Nginx) can target them.
#   Set DASHBOARD_BIND / AUTHENTIK_BIND to the LAN IP your external proxy reaches
#   (use 0.0.0.0 to listen on all interfaces) and pick free host ports.
INSTALL_PROXY=true
DASHBOARD_BIND=127.0.0.1
DASHBOARD_PORT=8080
AUTHENTIK_BIND=127.0.0.1
AUTHENTIK_PORT=9000
CERT_PATH=./certs

# --- Authentik bootstrap ---
AUTHENTIK_SECRET_KEY=please-change-me-to-a-random-50-char-string
AUTHENTIK_BOOTSTRAP_PASSWORD=ChangeMe!2025
AUTHENTIK_BOOTSTRAP_TOKEN=please-change-me-token
AUTHENTIK_DB_PASSWORD=authentik-change-me

# --- SSO ---
# INSTALL_AUTHENTIK=true: Authentik-Container werden mit gestartet (Profil "authentik").
# false: nutze die externe Instanz unter AUTHENTIK_URL.
INSTALL_AUTHENTIK=true
AUTHENTIK_URL=https://dashboard.local/auth
AUTHENTIK_REALM=dashboard
OIDC_CLIENT_ID=dashboard
OIDC_CLIENT_SECRET=

# --- Frontend (Vite) - baked in at build time ---
VITE_AUTH_REQUIRED=true
VITE_OIDC_AUTHORITY=https://dashboard.local/auth/application/o/dashboard/
VITE_OIDC_CLIENT_ID=dashboard
VITE_OIDC_REDIRECT_URI=https://dashboard.local/auth/callback
VITE_OIDC_POST_LOGOUT_URI=https://dashboard.local/login
VITE_SSO_GOOGLE_ENABLED=true
VITE_SSO_MICROSOFT_ENABLED=true
VITE_SSO_SAML_ENABLED=true
VITE_SSO_OIDC_ENABLED=true
VITE_SSO_PASSWORD_ENABLED=true
