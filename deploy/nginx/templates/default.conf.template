# Docker's embedded DNS at 127.0.0.11. Without this nginx resolves upstream
# hostnames ONCE at startup and caches the IP forever — when a container is
# recreated (new IP) every request becomes 502 Bad Gateway.
resolver 127.0.0.11 valid=10s ipv6=off;

server {
  listen 80;
  server_name ${HOSTNAME};
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${HOSTNAME};

  ssl_certificate     /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers on;

  location /api/ {
    # Variable in proxy_pass disables nginx's automatic URI rewriting, so we
    # must pass $request_uri explicitly — otherwise upstream only sees "/api/".
    set $api_upstream http://api:3001;
    proxy_pass $api_upstream$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }

  # OIDC callback belongs to the SPA, NOT to authentik. Must come BEFORE the
  # /auth/ proxy block so it wins the longest-prefix match (= sign forces
  # exact match).
  location = /auth/callback {
    set $dashboard_upstream http://dashboard:80;
    proxy_pass $dashboard_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
  }

  location /auth/ {
    # Same caveat as /api/: with a variable in proxy_pass we MUST append
    # $request_uri so the path survives. Authentik validates the Host header,
    # so forward the upstream's hostname (not $host).
    set $authentik_upstream https://sso.servuswir.de:9443;
    proxy_pass $authentik_upstream$request_uri;
    proxy_ssl_server_name on;
    proxy_set_header Host sso.servuswir.de:9443;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto https;
  }

  location / {
    set $dashboard_upstream http://dashboard:80;
    proxy_pass $dashboard_upstream;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
  }
}
