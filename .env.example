# Frontend → Backend-API
# Im Browser benutzte URL-Basis (Produktion: hinter nginx, der /api an api:3001 proxyt).
VITE_API_URL=/api

# Nur für lokale Entwicklung (vite dev): Ziel des /api-Proxys.
# Standard ist http://127.0.0.1:3001 (Docker-Mapping von deploy-api-1).
# VITE_API_PROXY_TARGET=http://127.0.0.1:3001
